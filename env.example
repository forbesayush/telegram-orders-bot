# ==============================================================
# Telegram Orders Bot - Environment Configuration Example
# Copy this file to .env and populate your actual values.
# NEVER commit your real .env file with tokens to version control!
# ==============================================================

# Required: Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Target Google Apps Script Web App URL
SCRIPT_URL=https://script.google.com/macros/s/AKfycbzqOmNRuLVKPAXtS3xwoSRxCzdRp-kOAyeseP9zmNolgp9IPeYyR1cK9hAS0t-2w7XX/exec

# Optional: Comma-separated Telegram User IDs allowed to interact with the bot
# Leave empty to allow any user to interact with the bot
ALLOWED_USER_IDS=

# Optional: Polling interval in minutes for auto-detecting new orders/returns
POLL_MINUTES=5

# Optional: Telegram Chat ID where background alerts for new orders/returns should be sent
ALERT_CHAT_ID=

# Optional: SQLite database file path
DATABASE_PATH=orders.db

# Optional: In-memory cache TTL in seconds (default 60s)
CACHE_TTL_SECONDS=60
